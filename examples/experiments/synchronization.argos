<?xml version="1.0" ?>
<argos-configuration>
  <framework>
    <system threads="0" />
    <experiment length="0" ticks_per_second="10" random_seed="124" />
  </framework>

  <controllers>
    <python_controller id="fsc" library="../../build/libpy_controller_interface.so">
      <actuators>
        <leds implementation="default" medium="leds" />
      </actuators>
      <sensors>
        <colored_blob_omnidirectional_camera implementation="rot_z_only" medium="leds" show_rays="true" />
      </sensors>
      <params script="../controllers/footbot_synchronization.py" />
    </python_controller>
  </controllers>

  <arena size="3,3,1" center="0,0,0.5">
    <box id="wall_north" size="2,0.1,0.125" movable="false">
      <body position="0,1,0" orientation="0,0,0" />
    </box>
    <box id="wall_south" size="2,0.1,0.125" movable="false">
      <body position="0,-1,0" orientation="0,0,0" />
    </box>
    <box id="wall_east" size="0.1,2,0.125" movable="false">
      <body position="1,0,0" orientation="0,0,0" />
    </box>
    <box id="wall_west" size="0.1,2,0.125" movable="false">
      <body position="-1,0,0" orientation="0,0,0" />
    </box>

    <!-- A compact grid lets robots see each other's LED flashes. -->
    <distribute>
      <position method="grid" center="0,0,0" distances="0.3,0.3,0" layout="4,4,1" />
      <orientation method="constant" values="0,0,0" />
      <entity quantity="16" max_trials="1">
        <foot-bot id="fb">
          <controller config="fsc" />
        </foot-bot>
      </entity>
    </distribute>
  </arena>

  <physics_engines>
    <dynamics2d id="dyn2d" />
  </physics_engines>

  <media>
    <led id="leds" />
  </media>
  <visualization>
    <qt-opengl />
  </visualization>
</argos-configuration>
