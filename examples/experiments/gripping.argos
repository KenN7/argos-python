<?xml version="1.0" ?>
<argos-configuration>
  <framework>
    <system threads="0" />
    <experiment length="20" ticks_per_second="10" random_seed="124" />
  </framework>

  <controllers>
    <python_controller id="fgc" library="../../build/libpy_controller_interface.so">
      <actuators>
        <differential_steering implementation="default" />
        <footbot_gripper implementation="default" />
      </actuators>
      <sensors />
      <params script="../controllers/footbot_gripping.py" />
    </python_controller>
  </controllers>

  <arena size="2,2,1" center="0,0,0.5">
    <foot-bot id="fb_0">
      <body position="0,0,0" orientation="0,0,0" />
      <controller config="fgc" />
    </foot-bot>

    <!-- Movable mass makes the cylinder grippable. -->
    <cylinder id="c" height="0.2" radius="0.1" mass="0.1" movable="true">
      <body position="0.5,0,0" orientation="0,0,0" />
    </cylinder>
  </arena>

  <physics_engines>
    <dynamics2d id="dyn2d" />
  </physics_engines>

  <media />
  <visualization>
    <qt-opengl />
  </visualization>
</argos-configuration>
