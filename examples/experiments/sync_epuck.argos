<?xml version="1.0" ?>
<argos-configuration>

  <!-- ************************* -->
  <!-- * General configuration * -->
  <!-- ************************* -->
  <framework>
    <experiment length="0" ticks_per_second="10" />
  </framework>

  <!-- *************** -->
  <!-- * Controllers * -->
  <!-- *************** -->
  <controllers>

    <python_controller id="fsc" library="../../build/libpy_controller_interface.so">
      <actuators>
      </actuators>
      <sensors>
      </sensors>
      <params script="../controllers/synchronization_range_and_bearing.py"/>
    </python_controller>
  </controllers>

  <!-- *********************** -->
  <!-- * Arena configuration * -->
  <!-- *********************** -->
  <arena size="4, 4, 1" center="0,0,0.5">
    <distribute>
      <position method="grid" center="0 ,0 ,0" distances="1,1,0" layout="4,4,1"/>
      <orientation method="uniform" min="0,0,0" max="0,0,0"/>
      <entity quantity="16" max_trials="100"> 
        <e-puck id="fb">
          <controller config="fsc" />
        </e-puck>
      </entity> 
    </distribute> 
  </arena>

  <!-- ******************* -->
  <!-- * Physics engines * -->
  <!-- ******************* -->
  <physics_engines>
    <dynamics2d id="dyn2d" />
  </physics_engines>

  <!-- ********* -->
  <!-- * Media * -->
  <!-- ********* -->
  <media>
  </media>

  <!-- ****************** -->
  <!-- * Visualization * -->
  <!-- ****************** -->
  <visualization>

    <qt-opengl>
    </qt-opengl>

  </visualization>

</argos-configuration>
